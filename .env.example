# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Local ASR via faster-whisper (no API key required).
#   WHISPER_MODEL          tiny / base / small / medium / large-v3   (default: small)
#   WHISPER_DEVICE         cpu / cuda                                (default: cpu)
#   WHISPER_COMPUTE_TYPE   int8 / int8_float16 / float16 / float32   (default: int8)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Free TTS via edge-tts (Microsoft Edge online voices)
EDGE_TTS_VOICE=ko-KR-SunHiNeural

# === 모델 선택 (속도 vs 정확도 트레이드오프) ===
# 비전: 냉장고 사진→재료 인식. 정확도 우선이면 Sonnet/Opus, 비용 우선이면 Haiku
#   claude-haiku-4-5-20251001 — 가장 빠르고 저렴, 단순 인식만 (한국 식재료 디테일 약함)
#   claude-sonnet-4-6         — 균형, 한국 식재료 디스앰비큐에이션 좋음 ⭐ 추천
#   claude-opus-4-7           — 최강, 비용 ↑↑
VISION_MODEL=claude-sonnet-4-6

# 레시피: 재료→레시피 텍스트 생성. 속도가 UX에 직결됨
#   claude-haiku-4-5-20251001 — 5~8초 응답, 한식 충분 ⭐ 추천
#   claude-sonnet-4-6         — 15~20초, 더 풍부한 설명
RECIPE_MODEL=claude-haiku-4-5-20251001

# Storage backend: "sqlite" (default, local file) or "firestore" (Firebase Cloud Firestore)
STORAGE_BACKEND=sqlite

# === 인증 (FastAPI 백엔드) ===
# JWT 서명 비밀키 — 32자 이상 랜덤 문자열을 권장. 노출 시 모든 토큰 위조 가능.
#   생성 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-48-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Google OAuth 클라이언트 ID (console.cloud.google.com → Credentials → OAuth client ID, type=Web)
# Authorized JavaScript origins에 http://localhost:3000 과 배포 도메인을 추가하세요.
GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com

# CORS 허용 출처 — 콤마 구분. 프로덕션에선 PWA 도메인만 허용하세요.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# === 컨텐츠 모더레이션 (게시판) ===
# huggingface.co/settings/tokens 에서 read 권한 토큰 발급. 미설정 시 모더레이션 자동 skip.
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 임계값 0.0~1.0 (기본 0.7) — 낮추면 더 엄격, 올리면 더 관대
MODERATION_THRESHOLD=0.7
MODERATION_TIMEOUT_SEC=5
# 모델은 기본값 권장: 텍스트 smilegate-ai/kor_unsmile, 이미지 Falconsai/nsfw_image_detection
# HF_TEXT_MODEL=smilegate-ai/kor_unsmile
# HF_IMAGE_MODEL=Falconsai/nsfw_image_detection

# === Firestore 사용 시에만 필요 ===

# 서비스 계정 JSON 키 파일 경로 (Firebase Console > Project Settings > Service accounts에서 다운로드)
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# 사용자 ID (Firebase Auth 도입 전 임시 식별자, 기본값: "local")
# FIREBASE_USER_ID=local
