# 백엔드 API 위치
# 로컬 개발: http://localhost:8000
# 프로덕션: https://api.culinary-agent.app  (배포 후 도메인)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth Web Client ID — backend의 GOOGLE_CLIENT_ID와 동일한 값을 넣어야 합니다.
# 미설정 시 Google 로그인 버튼이 자동으로 숨겨지고 이메일+비밀번호만 활성화됩니다.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com

# (선택) Next.js rewrites로 /api/* → 백엔드 프록시. 설정 시 NEXT_PUBLIC_API_URL을 "/api"로 둘 수 있음.
# BACKEND_URL=http://localhost:8000
